@model ExamResultDTO

@{
    ViewBag.Title = "نتیجه آزمون - " + Model.ExamTitle;
}
@section Styles{
    <link href="~/Static/Css/ResultExam.css" rel="stylesheet" />
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="custom-alert">
        <span class="custom-alert-icon">✓</span>
        @TempData["ErrorMessage"]
    </div>
}
<div class="container result-container animate-slide">
    <div class="card result-card">

       
        @{
            string headerClass = "neutral";
            string statusText = "پایان آزمون";
            string circleClass = "neutral";

            if (!Model.IsCorrected)
            {
                headerClass = "pending";
                circleClass = "pending";
                statusText = "در انتظار تصحیح (سوالات تشریحی)";
            }
            else if (Model.HasPassingScore)
            {
                if (Model.IsPassed == true)
                {
                    headerClass = "passed";
                    circleClass = "passed";
                    statusText = "قبول شده";
                }
                else
                {
                    headerClass = "failed";
                    circleClass = "failed";
                    statusText = "مردود";
                }
            }
        }

        <div class="result-header @headerClass">
            <h1>@Model.ExamTitle</h1>
            <div class="status-badge">
                <i class="fas fa-info-circle ml-1"></i> @statusText
            </div>
        </div>

        <div class="score-circle-wrapper">
            <div class="score-circle @circleClass">
                @if (Model.IsCorrected && Model.Percentage.HasValue)
                {
                    <span class="number">@Model.Percentage%</span>
                    <span class="label">درصد نمره</span>
                }
                else
                {
                    <span class="number"><i class="fas fa-hourglass-half text-warning"></i></span>
                    <span class="label">نامشخص</span>
                }
            </div>
        </div>

        <div class="card-body px-4 pb-4">

            <div class="row">
                <div class="col-6 col-md-3">
                    <div class="stat-card stat-primary">
                        <div class="value">
                            @(Model.IsCorrected? Model.Score?.ToString() ?? "0" : "--")
                        </div>
                        <div class="label">نمره کسب شده</div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="stat-card stat-primary">
                        <div class="value">@Model.TotalScore</div>
                        <div class="label">نمره کل آزمون</div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="stat-card stat-warning">
                        <div class="value">
                            @(Model.HasPassingScore? Model.PassingScore.ToString() : "ندارد")
                        </div>
                        <div class="label">حد نصاب قبولی</div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="stat-card @(Model.IsCorrected ? "stat-success" : "stat-warning")">
                        <div class="value" style="font-size: 1rem;">
                            @(Model.IsCorrected ? "تصحیح شده" : "در انتظار تصحیح")
                        </div>
                        <div class="label">وضعیت تصحیح</div>
                    </div>
                </div>
            </div>
            @if (Model.IsCorrected)
            {
                <div class="row mt-3">
                    <div class="col-4">
                        <div class="stat-card stat-success">
                            <div class="value text-success">@Model.CorrectAnswers</div>
                            <div class="label">پاسخ‌های صحیح</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card stat-danger">
                            <div class="value text-danger">@Model.WrongAnswers</div>
                            <div class="label">پاسخ‌های غلط</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card stat-warning">
                            <div class="value text-muted">@Model.Unanswered</div>
                            <div class="label">بدون پاسخ</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light text-center mt-3 border">
                    <i class="fas fa-chart-pie ml-1 text-muted"></i>
                    <small class="text-muted">آمار دقیق پاسخ‌ها پس از تصحیح سوالات تشریحی فعال خواهد شد.</small>
                </div>
            }           

            <div class="text-center mt-4 pt-3 border-top">
                @if (Model.CanDownloadCertificate)
                {
                    <a href="/Certificate/GetCertificate/@Model.CertificateUrl" class="btn btn-certificate btn-custom btn-lg btn-block mb-3">
                        <i class="fas fa-award ml-2"></i> دانلود گواهینامه دوره
                    </a>
                }
                else if (Model.HasCertificate && !Model.CanDownloadCertificate && Model.IsCorrected)
                {
                    <div class="alert alert-warning text-center small mb-3">
                        <i class="fas fa-exclamation-triangle ml-1"></i> گواهینامه فقط در صورت کسب حد نصاب قبولی صادر می‌شود.
                    </div>
                }

            </div>

        </div>
    </div>
</div>

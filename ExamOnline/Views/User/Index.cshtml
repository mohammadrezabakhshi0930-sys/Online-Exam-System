@model IEnumerable<GetUserDTO>
@{
    ViewBag.Title = "کاربران";
}
@section Styles
{
    <link rel="stylesheet" href="~/Static/Css/Question.css" />
}
<div class="table-wrapper">
    <div class="Div-TableItems">
        <div class="table-header-1">
            <h3>کاربران</h3>
        </div>
        <div class="table-header">
            <div class="table-title"> کاربران</div>
        </div>
        <div id="body_Result">
            <table>
                <thead>
                    <tr>
                        <th> نام کاربر</th>
                        <th>تاریخ ثبت نام</th>
                        <th>نام کاربری</th>
                        <th>سطح دسترسی</th>
                        <th> افزودن دسترسی</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (GetUserDTO temp in Model)
                    {
                        <tr>
                            <td data-label="نام کاربر "  title="@temp.Name">@temp.Name</td>
                            <td data-label="تاریخ ثبت نام" title="@temp.DateCreate">@temp.DateCreate.ToShortDateString()</td>
                            <td data-label="نام کاربری" title="@temp.UserName">@temp.UserName</td>
                            <td data-label="سطح دسترسی" >@(string.Join(',',temp.Role!))</td>
                            <td data-label="عملیات">
                                <a href="/User/ChangeRole?UserId=@temp.Id&Role=SuperAdmin" class="submit-btn-a">سوپر ادمین</a>
                                <a href="/User/ChangeRole?UserId=@temp.Id&Role=Admin" class="submit-btn-a"> ادمین</a>
                                <a href="/User/ChangeRole?UserId=@temp.Id&Role=User" class="submit-btn-a">کاربر</a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        </div>
    </div>
</div>

